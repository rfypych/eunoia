# Copy to .env for local dev. Never commit .env (it is git-ignored).
# DATABASE_URL must NOT contain a password — config rejects it.
DATABASE_URL=postgresql+psycopg://eunoia@localhost:5432/eunoia
# Vault key names only — never the actual secret values.
HACKERONE_TOKEN_REF=hackerone/api-token
NVD_API_KEY_REF=nvd/api-key
